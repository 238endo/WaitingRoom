{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "../WaitingRoom.Web/wwwroot/js",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module

    /* ----------------------------------------------------------------------------------
     module は、TypeScriptを変換した後のJavaScriptの形式を決める。
    
     CommonJS
       require や exports を使う形式。既存のNode.jsコードに合わせるときに使う。
    
     NodeNext
       Node.jsで動かすコード向け。今回のような .ts ファイルでは、
       package.json の "type" を見て出力形式を決める。
       "commonjs" なら require / exports、"module" なら import / export を使う。
    
     ESNext（今回使う設定）
       import や export を使うESモジュール形式で出力する。
       受付画面では、生成した reception.js を
       <script type="module"> でブラウザーから読み込む。
    ---------------------------------------------------------------------------------- */

    "module": "ESNext",
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": false,      // 出力例：app.js.map
    "declaration": false,    // 出力例：app.d.ts
    "declarationMap": false, // 出力例：app.d.ts.map

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "include": ["src/**/*.ts"]
}
