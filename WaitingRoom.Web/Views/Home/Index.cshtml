@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>

    @* 開発環境でホームを開いたときだけ、動作確認用のリンクを表示する。 *@
    <environment include="Development">
        <div class="d-flex flex-wrap justify-content-center gap-2">
            @* asp-controller は PagesController、asp-action は開きたい画面のアクションを指定する。 *@
            <a class="btn btn-primary" asp-controller="Pages" asp-action="Reception">受付画面を開く</a>
            <a class="btn btn-primary" asp-controller="Pages" asp-action="WaitingRoom">待合室画面を開く</a>
        </div>
    </environment>
</div>
