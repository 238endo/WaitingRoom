<h1 class="waiting-room-title">待合室画面</h1>

<section class= "waiting-number">
    <h2>呼び出し中の番号</h2>
    <!-- TypeScript が id を使って、呼び出し番号と待機人数の表示を更新する。 -->
    <p id="calling-number">未取得</p>
    <p id="calling-message" hidden>受付へお越しください</p>
</section>

<section class="waiting-people">
    <div>
        <h2>待機人数</h2> 
        <span id="waiting-count">未取得</span>
        <button type="button" id="refresh-queue">更新</button>
    </div>
</section>

<!-- npx tsc が生成した待合室用の JavaScript を読み込む。 -->
<script type="module" src="/js/waiting-room.js"></script>

@* 待合室画面の CSS を、共通レイアウトの <head> に追加する。 *@
@section Styles {
    <link rel="stylesheet" href="~/css/waiting-room.css" asp-append-version="true" />
}
